        { "name": "icon-fit", "kind": "string", "required": false, "default": "contain", "enum": ["contain", "fill"] },
        { "name": "icon-padding", "kind": "number", "required": false, "default": 4 },
        { "name": "icon-only", "kind": "boolean", "required": false, "default": false },
