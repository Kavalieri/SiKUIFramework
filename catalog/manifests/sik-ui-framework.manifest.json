      { "name": "overflow", "valueKinds": ["string", "data"] },
      { "name": "align", "valueKinds": ["string", "data"] },
      { "name": "align-x", "valueKinds": ["string", "data"] },
      { "name": "align-y", "valueKinds": ["string", "data"] },
      { "name": "vertical-align", "valueKinds": ["string", "data"] },
