    { "id": "container", "runtimeFactory": "SiK.UI.Container.create", "htmlTag": "div", "htmlClass": "sik-container", "events": ["change"], "allowedChildren": ["container", "scroll", "table", "virtual-list", "block", "form", "card", "card-collection", "collection", "action-group", "control"], "props": [{ "name": "direction", "kind": "string", "required": false, "default": "column", "enum": ["row", "column"] }, { "name": "overflow", "kind": "string", "required": false, "default": "clip", "enum": ["clip", "visible", "scroll"] }], "supportsColumns": true, "supportsOptions": true, "editorGroup": "structure" },
    { "id": "scroll", "runtimeFactory": "SiK.UI.Scroll.create", "htmlTag": "div", "htmlClass": "sik-scroll", "events": [], "allowedChildren": ["container"], "props": [], "supportsColumns": false, "supportsOptions": false, "editorGroup": "structure" },
    { "id": "virtual-list", "runtimeFactory": "SiK.UI.VirtualList.create", "htmlTag": "div", "htmlClass": "sik-virtual-list", "events": ["change","activate"], "allowedChildren": [], "props": [{ "name": "data", "kind": "data", "required": true }], "supportsColumns": false, "supportsOptions": false, "editorGroup": "data" },
