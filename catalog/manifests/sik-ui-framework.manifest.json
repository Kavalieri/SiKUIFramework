        { "name": "dismissible", "kind": "boolean", "required": false, "default": true },
        { "name": "escape", "kind": "boolean", "required": false, "default": true }
      ]
    },
    {
      "id": "block.header",
      "componentType": "block",
      "props": [
        { "name": "info-visible", "kind": "boolean", "required": false, "default": false },
