    { "id": "block", "runtimeFactory": "SiK.UI.Block.create", "htmlTag": "section", "htmlClass": "sik-block", "events": ["activate"], "allowedChildren": ["container", "scroll", "table", "virtual-list", "form", "card", "card-collection", "collection", "action-group", "control"], "props": [{ "name": "title", "kind": "i18n", "required": false }, { "name": "help", "kind": "i18n", "required": false }, { "name": "scrollable", "kind": "boolean", "required": false, "default": false }], "supportsColumns": false, "supportsOptions": false, "editorGroup": "content" },
    { "id": "form", "runtimeFactory": "SiK.UI.Form.create", "htmlTag": "section", "htmlClass": "sik-form", "events": ["change","submit"], "allowedChildren": ["control"], "props": [{ "name": "data", "kind": "data", "required": true }, { "name": "fields", "kind": "data", "required": false }], "supportsColumns": false, "supportsOptions": true, "editorGroup": "form" },
    { "id": "card", "runtimeFactory": "SiK.UI.Card.create", "htmlTag": "article", "htmlClass": "sik-card", "events": ["activate"], "allowedChildren": [], "props": [{ "name": "title", "kind": "i18n", "required": false }, { "name": "variant", "kind": "string", "required": false, "default": "standard", "enum": ["standard", "summary"] }, { "name": "data", "kind": "data", "required": false }], "supportsColumns": false, "supportsOptions": false, "editorGroup": "content" },
    { "id": "card-collection", "runtimeFactory": "SiK.UI.CardCollection.create", "htmlTag": "div", "htmlClass": "sik-card-collection", "events": ["activate"], "allowedChildren": ["card"], "props": [{ "name": "items", "kind": "data", "required": false }, { "name": "columns", "kind": "number", "required": false }, { "name": "maxColumns", "kind": "number", "required": false }, { "name": "exactColumns", "kind": "boolean", "required": false, "default": false }, { "name": "cardVariant", "kind": "string", "required": false }], "supportsColumns": true, "supportsOptions": false, "editorGroup": "content" },
    { "id": "collection", "runtimeFactory": "SiK.UI.Collection.create", "htmlTag": "div", "htmlClass": "sik-collection", "events": ["activate"], "allowedChildren": [], "props": [{ "name": "data", "kind": "data", "required": true }], "supportsColumns": true, "supportsOptions": false, "editorGroup": "content" },
    { "id": "action-group", "runtimeFactory": "SiK.UI.ActionGroup.create", "htmlTag": "div", "htmlClass": "sik-action-group", "events": ["activate"], "allowedChildren": ["control"], "props": [{ "name": "mode", "kind": "string", "required": false, "default": "content", "enum": ["content", "equal", "wrap", "stack"] }], "supportsColumns": false, "supportsOptions": false, "editorGroup": "control" },
    { "id": "tooltip", "runtimeFactory": "SiK.UI.Tooltip.attach", "htmlTag": "div", "htmlClass": "sik-tooltip", "events": ["hover"], "allowedChildren": [], "props": [{ "name": "data", "kind": "data", "required": true }], "supportsColumns": false, "supportsOptions": false, "editorGroup": "overlay" },
    { "id": "menu", "runtimeFactory": "SiK.UI.Menu.create", "htmlTag": "nav", "htmlClass": "sik-menu", "events": ["contextmenu"], "allowedChildren": [], "props": [{ "name": "data", "kind": "data", "required": false }], "supportsColumns": false, "supportsOptions": true, "editorGroup": "overlay" },
    { "id": "drag", "runtimeFactory": "SiK.UI.Drag.begin", "htmlTag": "div", "htmlClass": "sik-drag", "events": ["dragstart","dragover","drop","dragcancel"], "allowedChildren": [], "props": [{ "name": "data", "kind": "data", "required": true }], "supportsColumns": false, "supportsOptions": false, "editorGroup": "overlay" },
    { "id": "control", "runtimeFactory": "SiK.UI.Controls.create", "htmlTag": "div", "htmlClass": "sik-control", "events": ["activate","change","submit"], "allowedChildren": [], "props": [{ "name": "kind", "kind": "string", "required": true, "enum": ["button", "icon-button", "field", "combo", "search", "toggle", "status", "feedback", "section-title", "progress", "alert-row", "header-operation", "requirement-row"] }, { "name": "label", "kind": "i18n", "required": false }, { "name": "data", "kind": "data", "required": false }, { "name": "icon", "kind": "asset", "required": false }, { "name": "icon-key", "kind": "string", "required": false }, { "name": "enabled", "kind": "boolean", "required": false, "default": true }, { "name": "size", "kind": "number", "required": false }, { "name": "glow", "kind": "boolean", "required": false, "default": false }, { "name": "mode", "kind": "string", "required": false, "enum": ["determinate", "indeterminate"] }, { "name": "status", "kind": "string", "required": false }, { "name": "tone", "kind": "string", "required": false }, { "name": "severity", "kind": "string", "required": false, "enum": ["info", "warning", "danger"] }], "supportsColumns": false, "supportsOptions": true, "editorGroup": "control" },
